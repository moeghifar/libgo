# Copy to .env for local runs. Never commit .env.
LOG_LEVEL=INFO
APP_ADDR=127.0.0.1:8080
# Required by serve. Comma-separated; generate with: openssl rand -hex 32
API_TOKENS=
RATE_LIMIT=100
DOCS_ENABLED=false
# Set only behind a proxy you control: X-Forwarded-For is otherwise spoofable.
TRUST_PROXY=false
# Required by migrate only.
DB_DSN=
